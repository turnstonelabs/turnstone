@startuml
title Turnstone - coordinator wait_for_workstream lifecycle

skinparam sequenceArrowThickness 1.5
skinparam noteBackgroundColor #FDF6E3

participant "Coordinator\nLLM" as LLM
participant "ChatSession\n(worker thread)" as CS
participant "CoordinatorClient" as CC
participant "SessionUI\n(SSE fanout)" as UI
participant "Console routing\nproxy" as RP
database "Storage\n(workstreams row)" as DB
participant "Child\nnode" as NODE

== Spawn ==

LLM -> CS : tool_call spawn_workstream(...)
activate CS
CS -> CC : spawn(initial_message=...,\nparent_ws_id=coord, user_id=...)
CC -> RP : POST /v1/api/route/workstreams/new
RP -> NODE : dispatch (rendezvous)
NODE -> DB : insert workstreams row\nstate='running'
RP --> CC : {ws_id, node_id, name, status: 200}
CC --> CS : {ws_id, ...}
CS -> UI : on_tool_result\n("spawn_workstream", ws_id)
deactivate CS

note right of LLM
  Model now knows the child ws_id.
  It can inspect / send / wait, and
  the parent registry tracks it.
end note

== Wait (blocking) ==

LLM -> CS : tool_call wait_for_workstream\n(ws_ids=[child], mode="any", timeout=60)
activate CS
CS -> CS : _prepare_wait_for_workstream\n(the batch runs in model order)
CS -> UI : emit wait_started\n{call_id, ws_ids, mode, timeout}

CS -> CC : wait_for_workstream(ws_ids, timeout, mode,\nsince, progress_callback, interrupt, wake_event)
activate CC
CC -> CC : validate ws_ids\n(a garbled id fails here;\na foreign one on the first tick)

loop until the mode condition, a since change, a stall,\nan unknown id, the timeout or a user message
    CC -> DB : read rows + token counts\n(two batch reads per tick)
    DB --> CC : {state, updated, tokens, ...}
    CC -> CS : progress_callback(snap)
    CS -> UI : emit wait_progress\n{call_id, elapsed, results?}\n(on change, or a 5 s heartbeat)
    alt real-terminal state (idle, error, closed, deleted)
        note over CC
          mode condition met ->
          complete, leave the loop
        end note
    else still running / thinking / attention
        CC -> CC : block on the wake event:\na child state change, a user message\nor the 2 s heartbeat
    end
end

CC -> DB : read each finished child's message, whole\n(an error child's stored error first)
CC --> CS : {complete, elapsed, mode,\nresults: {ws_id: {state, ..., message}}}
deactivate CC

CS -> UI : on_tool_result\n("wait_for_workstream",\n"complete after Ns (R/N resolved)")
CS -> UI : emit wait_ended\n{call_id, complete, elapsed,\nresults: states only}
CS -> CS : batch admission fits the result\nto the room it grants: as many messages\nwhole as fit, the rest cut\n(truncated, message_chars)
CS --> LLM : tool_result (fitted results)
deactivate CS

note left of UI
  wait_started / wait_progress / wait_ended
  carry call_id, so each wait stays separate
  for an SSE listener; no page renders them:
  the coordinator page shows the tool row's
  summary line.
end note

== After wait: close ==

note right of LLM
  Each finished child's last message
  arrives in the wait's results;
  inspect_workstream is for a child's
  earlier turns, or a cut message.
end note

LLM -> CS : tool_call close_workstream\n(ws_id=child, reason="...")
CS -> CC : close_workstream(ws_id, reason)
CC -> RP : POST /v1/api/route/workstreams/close
RP -> NODE : dispatch
NODE -> DB : state='closed',\nclose_reason='...'
RP --> CC : {status: 200}
CC --> CS : {closed: true, status: 200, reason: ...}
CS --> LLM : tool_result
@enduml
